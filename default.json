{
    "project": {
        "name": "VULNSCOPE",
        "version": "0.1.0"
    },

    "scan": {
        "timeout": 300,
        "max_threads": 10
    },

    "modules": {
        "discovery": true,
        "web_scanner": true,
        "network_scanner": true,
        "validation": true,
        "reporter": true
    },

    "output": {
        "directory": "./reports",
        "formats": [
            "pdf"
        ]
    },

    "scope": {
        "allowed_targets": [],
        "excluded_targets": []
    }
}
